# Dev image: Go toolchain + Air + CGO deps. Source is bind-mounted at runtime.
FROM golang:1.26-bookworm

ARG APK_MIRROR_ARG=
ARG GOPROXY_ARG=https://proxy.golang.org,direct
ARG GOSUMDB_ARG=off

ENV GOPROXY=${GOPROXY_ARG}
ENV GOSUMDB=${GOSUMDB_ARG}
ENV CGO_ENABLED=1
ENV PATH="/go/bin:${PATH}"

RUN if [ -n "$APK_MIRROR_ARG" ]; then \
        sed -i "s@deb.debian.org@${APK_MIRROR_ARG}@g" /etc/apt/sources.list.d/debian.sources; \
    fi && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        git build-essential libsqlite3-dev curl bash && \
    rm -rf /var/lib/apt/lists/*

RUN go install github.com/air-verse/air@latest

WORKDIR /app

COPY go.mod go.sum ./
COPY third_party/anydoc-go/go.mod third_party/anydoc-go/go.mod
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY cmd/download cmd/download
RUN go run cmd/download/duckdb/duckdb.go

COPY docker/scripts/dev-app-entrypoint.sh /usr/local/bin/dev-app-entrypoint.sh
RUN chmod +x /usr/local/bin/dev-app-entrypoint.sh

EXPOSE 8080
ENTRYPOINT ["dev-app-entrypoint.sh"]
CMD ["air", "-c", "docker/air.docker.toml"]
